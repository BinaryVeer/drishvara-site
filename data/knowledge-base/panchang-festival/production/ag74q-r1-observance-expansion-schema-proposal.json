      "Passover"
    ],
    "parent_event_id": "links child events to a governed parent sequence",
    "event_sequence": "orders child events inside a governed sequence",
    "day_number": "optional reader-facing sequence day when source-approved",
    "civil_date_start": "supported for governed parent spans",
    "civil_date_end": "supported for governed parent spans",
    "independent_governance_required": "Parent observance records and significant child event records must each satisfy their own approval gates."
  },
  "public_filter_derivation_contract": {
    "derived_public_filter_facets": {
      "derived_from": [
        "tradition",
        "event_class",
        "legal_status_entries.status",
        "legal_status_entries.jurisdiction"
      ],
      "stored_as_competing_source_of_truth": false,
      "requires_approved_canonical_fields": true
    },
    "public_filter_override": {
      "allowed": true,
      "required": false,
      "governance_required": true,
      "purpose": "Future editorial compatibility only; not a substitute for canonical identity, legal status or jurisdiction fields."
    }
  },
  "conditional_validation_rules": [
    {
      "rule_id": "ag74q_r1_fixed_civic_event",
      "description": "Fixed civic or international events do not require Panchang, lunar month, paksha or tithi fields.",
      "requires": [
        "event_id",
        "canonical_name",
        "tradition",
        "event_class",
        "date_basis_type"
      ],
      "panchang_fields_required": false
    },
    {
      "rule_id": "ag74q_r1_governed_timed_religious_event",
      "description": "Reader-visible Begins and Ends may display only when a governed primary_public_window is present and approved.",
      "when": {
        "timing_mode": "timed_window"
      },
      "requires_before_public_begins_ends": [
        "primary_public_window",
        "timing_rule source_evidence",
        "source_approval_status approved"
      ]
    },
    {
      "rule_id": "ag74q_r1_all_day_event",
      "description": "All-day and official civil day records may mark ritual/timed fields as optional or not applicable.",
      "when": {
        "timing_mode": [
          "all_day",
          "official_civil_day"
        ]
      },
      "timed_ritual_fields_required": false
    },
    {
      "rule_id": "ag74q_r1_legal_holiday",
      "description": "Legal holiday claims require at least one jurisdictional legal_status_entries item.",
      "when": {
        "legal_or_holiday_status_claimed": true
      },
      "requires": [
        "legal_status_entries[0]"
      ]
    },
    {
      "rule_id": "ag74q_r1_state_specific_holiday",
      "description": "State-specific holiday status requires state_or_ut inside the jurisdiction object.",
      "when": {
        "legal_status_entries.status": "state_specific"
      },
      "requires": [
        "legal_status_entries[].jurisdiction.state_or_ut"
      ]
    },
    {
      "rule_id": "ag74q_r1_year_specific_notification",
      "description": "Year-specific notification status requires both a valid_for_year and an official notification reference.",
      "when": {
        "date_basis_type": "official_notification"
      },
      "requires": [
        "legal_status_entries[].valid_for_year",
        "legal_status_entries[].official_notification_reference"
      ]
    },
    {
      "rule_id": "ag74q_r1_child_event",
      "description": "Child events inside a sequence require parent_event_id and event_sequence.",
      "when": {
        "is_child_event": true
      },
      "requires": [
        "parent_event_id",
        "event_sequence"
      ]
    },
    {
      "rule_id": "ag74q_r1_parana_or_conclusion",
      "description": "Parana or conclusion windows must not be created unless applicability, rule evidence and source evidence support them.",
      "when": {
        "parana_or_conclusion.applicability": "applicable"
      },
      "requires": [
        "parana_or_conclusion.type",
        "parana_or_conclusion.status",
        "parana_or_conclusion.window",
        "ritual_rule source_evidence",
        "source_approval_status approved"
      ]
    },
    {
      "rule_id": "ag74q_r1_approved_status",
      "description": "No record may become approved unless all conditionally required sources and rules for its event type are approved and certainty is sufficient for governed public output.",
      "when": {
        "governance.status": "approved"
      },
      "requires": [
        "required source_evidence entries approved",
        "required rule_basis approved",
        "certainty sufficient for governed public output for the event type",
        "public_output_allowed gate if future runtime projection is proposed"
      ],
      "approval_distinction": "Source/rule approval is necessary but not sufficient; a technically sourced record must remain withheld or pending if material uncertainty remains."
    },
    {
      "rule_id": "ag74q_r1_public_filters",
      "description": "Public filter facets must derive from approved canonical fields and must not be manually stored as a competing source of truth.",
      "requires_derivation_from": [
        "tradition",
        "event_class",
        "legal_status_entries",
        "jurisdiction"
      ],
      "manual_public_filter_facets_allowed": false
    }
  ],
